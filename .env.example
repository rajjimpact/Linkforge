# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=linkforge
DB_USERNAME=linkforge_user
DB_PASSWORD=your_strong_password_here

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===== JWT =====
JWT_SECRET=your_256_bit_minimum_base64_encoded_secret_here_minimum_32_chars
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ===== EMAIL (Gmail SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ===== APPLICATION =====
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_DOMAIN=localhost:8080

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== RATE LIMITING =====
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# ===== GOOGLE SAFE BROWSING =====
GOOGLE_SAFE_BROWSING_API_KEY=your_google_api_key_here
GOOGLE_SAFE_BROWSING_ENABLED=false

# ===== FILE STORAGE =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5MB

# ===== ADMIN =====
ADMIN_EMAIL=admin@linkforge.io
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# ===== MONITORING =====
MANAGEMENT_METRICS_ENABLED=true
